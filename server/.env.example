PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=legaltriage
DB_PASSWORD=change-this-local-password
DB_NAME=legaltriage
# Solo para inicializar un contenedor MySQL nuevo; usar otra clave propia.
MYSQL_ROOT_PASSWORD=change-this-local-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=development

# preview no envía mensajes; gmail habilita los botones de envío real.
MAIL_MODE=preview
SMTP_USER=
SMTP_APP_PASSWORD=
PUBLIC_APP_URL=http://localhost:5173
