{
  "name": "legaltriage-ai",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm test -w server",
    "db:init": "npm run db:init -w server",
    "user:create": "npm run user:create -w server",
    "gemini:check": "npm run gemini:check -w server",
    "gemini:models": "npm run gemini:models -w server",
    "gemini:text": "npm run gemini:text -w server",
    "gemini:curl": "npm run gemini:curl -w server",
    "gemini:interactions": "npm run gemini:interactions -w server",
    "mail:check": "npm run mail:check -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
