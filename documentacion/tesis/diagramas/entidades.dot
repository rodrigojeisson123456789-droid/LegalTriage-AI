digraph G {
graph [rankdir=LR,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.75,dpi=180];
node [shape=box,style="rounded,filled",fillcolor="#faf7f0",color="#ad8a4c",fontname="DejaVu Sans",fontsize=12,margin=0.16];
edge [color="#68655f",fontname="DejaVu Sans",fontsize=9];
node [fontsize=14];
edge [fontsize=10];
case_events [label="case_events\nid PK\nactor_id FK nullable"];
case_versions [label="case_versions\nevent_id PK/FK"];
cases [label="cases\nid PK\nlawyer_id FK nullable"];
clarifications [label="clarifications\nid PK"];
deadline_reminders [label="deadline_reminders\nid PK\nrecipient_id sin FK"];
deadlines [label="deadlines\nid PK"];
documents [label="documents\nid PK\ncase_id UNIQUE"];
evaluations [label="evaluations\ncase_id PK/FK\napproved_by FK nullable"];
lawyer_profiles [label="lawyer_profiles\nuser_id PK/FK"];
lawyer_specialties [label="lawyer_specialties\nPK(user_id,specialty)"];
notifications [label="notifications\nid PK"];
response_links [label="response_links\nid PK"];
users [label="users\nid PK"];
users -> case_events [label="actor_id",constraint=false,color="#a8a8a8"];
cases -> case_events [label="case_id"];
case_events -> case_versions [label="event_id"];
users -> cases [label="lawyer_id"];
cases -> clarifications [label="case_id"];
users -> clarifications [label="created_by",constraint=false,color="#a8a8a8"];
deadlines -> deadline_reminders [label="deadline_id"];
cases -> deadlines [label="case_id"];
users -> deadlines [label="created_by",constraint=false,color="#a8a8a8"];
cases -> documents [label="case_id"];
users -> evaluations [label="approved_by",constraint=false,color="#a8a8a8"];
cases -> evaluations [label="case_id"];
users -> evaluations [label="updated_by",constraint=false,color="#a8a8a8"];
users -> lawyer_profiles [label="user_id"];
users -> lawyer_specialties [label="user_id"];
cases -> notifications [label="case_id"];
users -> notifications [label="created_by",constraint=false,color="#a8a8a8"];
cases -> response_links [label="case_id"];
users -> response_links [label="created_by",constraint=false,color="#a8a8a8"];
}
